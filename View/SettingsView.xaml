<UserControl x:Class="STranslate.Plugin.Translate.OpenAICompetitive.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:plugin="clr-namespace:STranslate.Plugin;assembly=STranslate.Plugin">
    <StackPanel Margin="0,0,0,12">
        <TextBlock Text="{DynamicResource DisplayName}" Margin="0,8,0,4" />
        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MinWidth="300" />
        <TextBlock Text="API URL" Margin="0,12,0,4" />
        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding FinalUrl}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
        <TextBlock Text="API Key" Margin="0,12,0,4" />
        <PasswordBox plugin:PasswordBoxAssistant.Attach="True"
            plugin:PasswordBoxAssistant.Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{DynamicResource Model}" Margin="0,12,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ModelBox" ItemsSource="{Binding Models}" IsEditable="True"
                IsTextSearchEnabled="False" MinWidth="200" LostKeyboardFocus="OnModelLostKeyboardFocus"
                Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="{DynamicResource FetchModels}" Margin="8,0,0,0"
                Command="{Binding FetchModelsCommand}" />
            <Button Grid.Column="2" Content="−" Margin="8,0,0,0"
                Command="{Binding DeleteModelCommand}" CommandParameter="{Binding Model}" />
        </Grid>
        <TextBlock Text="{Binding FetchModelsResult}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="{DynamicResource Prompt_Header}" Margin="0,12,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{DynamicResource EditPrompt_Content}" Margin="8,0,0,0"
                Command="{Binding EditPromptCommand}" />
            <ComboBox DisplayMemberPath="Name" ItemsSource="{Binding Main.Prompts}"
                SelectedItem="{Binding Main.SelectedPrompt, Mode=TwoWay}" />
        </DockPanel>
        <TextBlock Text="{DynamicResource Temperature}" Margin="0,12,0,4" />
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Width="40" Text="{Binding Temperature, StringFormat=F1}" />
            <Slider Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"
                Value="{Binding Temperature, Mode=TwoWay}" />
        </DockPanel>
        <CheckBox Content="Stream" IsChecked="{Binding Stream}" Margin="0,12,0,4" />
        <TextBlock Text="MaxTokens (0 = provider default)" Margin="0,8,0,4" />
        <TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
        <Button Content="{DynamicResource PluginTranslateValidate}" Command="{Binding ValidateCommand}"
            HorizontalAlignment="Left" Margin="0,16,0,4" />
        <TextBlock Text="{Binding ValidateResult}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
